{
  // Plain browser JavaScript: no modules, no bundler, no TypeScript.
  // This tells VS Code what globals exist (document, window, dialog…)
  // and stops it reporting false "cannot find name" errors.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "checkJs": false,
    "allowJs": true
  },
  "include": ["js/**/*.js"],
  "exclude": ["node_modules"]
}
